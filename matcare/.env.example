# ── MongoDB Local Atlas ──────────────────────────────────────────────────────
# Get the real URI (the port is random if 27017 is taken):
#   atlas local connect matcare --connectWith connectionString
# directConnection=true is REQUIRED — without it the driver tries to resolve the
# container's internal replica-set hostname from your host and times out.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ── Models / names (defaults are fine) ───────────────────────────────────────
EMBEDDING_MODEL_ID=voyageai/voyage-4-nano
MONGODB_DB=matcare
